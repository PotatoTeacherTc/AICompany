# Safe local Beta defaults. Copy values into the current shell; do not commit
# a populated .env file.
ALLOW_PAID_PROVIDER=False
AICOMPANY_API_HOST=127.0.0.1
AICOMPANY_API_PORT=8000
AICOMPANY_WEB_PORT=8080
VITE_API_BASE_URL=http://127.0.0.1:8000
AICOMPANY_ENV=development
AICOMPANY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AICOMPANY_RATE_LIMIT_REQUESTS=120
AICOMPANY_RATE_LIMIT_WINDOW_SECONDS=60
# Required in production; use a random value of at least 32 characters.
AICOMPANY_SIGNING_SECRET=
AICOMPANY_SIGNING_SECRET_FILE=
DATABASE_URL_FILE=
REDIS_URL_FILE=
AICOMPANY_STORAGE_SIGNING_KEY_FILE=
AICOMPANY_TLS_CERT_FILE=
AICOMPANY_TLS_KEY_FILE=
AICOMPANY_HTTPS_PORT=8443
# Development Compose placeholder only. Replace through an untracked .env.
POSTGRES_PASSWORD=replace-with-local-secret
# Safe default is memory. Docker Compose explicitly selects postgresql; the
# production app factory then connects and applies additive migrations.
AICOMPANY_REPOSITORY_ADAPTER=memory
AICOMPANY_STATE_FILE=/data/state.json
DATABASE_URL=postgresql://aicompany:replace-with-local-secret@postgres:5432/aicompany
REDIS_URL=redis://redis:6379/0
AICOMPANY_QUEUE_BACKEND=memory
AICOMPANY_QUEUE_NAMESPACE=aicompany
AICOMPANY_QUEUE_BLOCKING_TIMEOUT=1
AICOMPANY_WORKER_WORKSPACES=default
AICOMPANY_REQUIRED_WORKERS=1
AICOMPANY_ARTIFACT_STORAGE=fake_s3
AICOMPANY_ARTIFACT_ROOT=
AICOMPANY_ARTIFACT_BUCKET=fake-artifacts
# Text defaults remain offline. OpenAI requires explicit local paid opt-in.
AICOMPANY_TEXT_PROVIDER=fake
AICOMPANY_TEXT_MODEL=
AICOMPANY_TEXT_PROVIDER_TIMEOUT=30
AICOMPANY_OLLAMA_ENDPOINT=http://127.0.0.1:11434
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
AICOMPANY_RUN_OPENAI_SMOKE=false
AICOMPANY_IMAGE_PROVIDER=fake
AICOMPANY_IMAGE_MODEL=
AICOMPANY_IMAGE_PROVIDER_TIMEOUT=30
AICOMPANY_COMFYUI_ENDPOINT=http://127.0.0.1:8188
AICOMPANY_COMFYUI_WORKFLOW_PATH=workflows/comfyui/checkpoint-basic-v1.json
AICOMPANY_RUN_COMFYUI_SMOKE=false
AICOMPANY_YOUTUBE_PROVIDER=fake
AICOMPANY_GOOGLE_CLIENT_SECRET_FILE=
AICOMPANY_YOUTUBE_OAUTH_REDIRECT_HOST=127.0.0.1
AICOMPANY_YOUTUBE_UPLOAD_ENABLED=false
AICOMPANY_RUN_YOUTUBE_SMOKE=false
AICOMPANY_YOUTUBE_DEFAULT_PRIVACY=private
AICOMPANY_YOUTUBE_UPLOAD_CHUNK_SIZE=8388608
AICOMPANY_YOUTUBE_TIMEOUT=120
