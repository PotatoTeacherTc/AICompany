# Safe local Beta defaults. Copy values into the current shell; do not commit
# a populated .env file.
ALLOW_PAID_PROVIDER=False
AICOMPANY_API_HOST=127.0.0.1
AICOMPANY_API_PORT=8000
AICOMPANY_WEB_PORT=8080
VITE_API_BASE_URL=http://127.0.0.1:8000
AICOMPANY_ENV=development
AICOMPANY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AICOMPANY_RATE_LIMIT_REQUESTS=120
AICOMPANY_RATE_LIMIT_WINDOW_SECONDS=60
# Required in production; use a random value of at least 32 characters.
AICOMPANY_SIGNING_SECRET=
# Development Compose placeholder only. Replace through an untracked .env.
POSTGRES_PASSWORD=replace-with-local-secret
# Safe default is memory. Docker Compose explicitly selects postgresql; the
# production app factory then connects and applies additive migrations.
AICOMPANY_REPOSITORY_ADAPTER=memory
AICOMPANY_STATE_FILE=/data/state.json
DATABASE_URL=postgresql://aicompany:replace-with-local-secret@postgres:5432/aicompany
REDIS_URL=redis://redis:6379/0
AICOMPANY_QUEUE_BACKEND=memory
AICOMPANY_QUEUE_NAMESPACE=aicompany
AICOMPANY_QUEUE_BLOCKING_TIMEOUT=1
AICOMPANY_WORKER_WORKSPACES=default
